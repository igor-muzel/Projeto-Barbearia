@{
    ViewData["Title"] = "Login";
}

<style>
    .omitir {
        display: none;
    }
 </style>

<div style="display: flex; justify-content: center; align-items: center; min-height: 70vh; padding: 1rem;">
    <div style="background-color: var(--bg-white); padding: 2.5rem; border-radius: var(--radius-md); box-shadow: var(--shadow-light); width: 100%; max-width: 400px;">

        <div style="text-align: center; margin-bottom: 2rem;">
            <h1 style="color: var(--color-charcoal); font-size: 1.8rem; margin-bottom: 0.5rem;">Acesse sua Conta</h1>
            <p style="color: var(--text-grey); font-size: 0.9rem;">Bem-vindo de volta ao Barba Negra</p>
        </div>

        <form id="loginForm">
            <div style="margin-bottom: 1.2rem;">
                <label for="email" style="display: block; color: var(--color-charcoal); margin-bottom: 0.5rem; font-weight: 500;">E-mail</label>
                <input type="email" id="email" name="email" placeholder="seu@email.com" required
                       style="width: 100%; padding: 12px; border: 1px solid #ddd; border-radius: var(--radius-md); background-color: var(--bg-light); color: var(--text-dark);">
            </div>

            <div style="margin-bottom: 1.5rem;">
                <label for="senha" style="display: block; color: var(--color-charcoal); margin-bottom: 0.5rem; font-weight: 500;">Senha</label>
                <input type="password" id="senha" name="senha" placeholder="••••••••" required
                       style="width: 100%; padding: 12px; border: 1px solid #ddd; border-radius: var(--radius-md); background-color: var(--bg-light); color: var(--text-dark);">
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; font-size: 0.85rem;">
                <label style="display: flex; align-items: center; gap: 5px; color: var(--text-grey); cursor: pointer;">
                    <input type="checkbox" id="lembrar" style="cursor: pointer;"> Lembrar-me
                </label>
                <a href="#" style="color: var(--color-bronze); font-weight: 500;">Esqueceu a senha?</a>
            </div>

            <button onclick="RealizarLogin()" type="button" id="btnEntrar"
                    style="width: 100%; background-color: var(--color-bronze); color: white; border: none; padding: 14px; border-radius: var(--radius-md); font-weight: bold; cursor: pointer; font-size: 1rem; transition: var(--transition);">
                Entrar
            </button>
        </form>

        <p style="margin-top: 2rem; text-align: center; color: var(--text-grey); font-size: 0.9rem;">
            Ainda não tem conta? <a href="#" style="color: var(--color-bronze); font-weight: bold;">Cadastre-se</a>
        </p>
    </div>
</div>

@section Scripts {
    <script>
        async function RealizarLogin(){
            const email = document.getElementById('email').value;
            const senha = document.getElementById('senha').value;

            console.log(email);
            //o javascript entende como falso/false os seguintes valores: "", null, 0, NaN
            if(!email || !senha){
                alert("Preencha todos os dados");
            }

            const dadosLogin = {
                email: email,
                senha: senha
            };

            try{
                //Chama a rota de Login no backend
                const resposta = await fetch('/Auth/RealizarLogin',{
                    method: 'POST',
                    headers: {
                    'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(dadosLogin)
                });

                if(resposta.ok){
                    
                    alert("Login realizado com sucesso: "+dadosLogin.email);
                    window.location.href = '/Home/Index';
                    
                    
                    

                }else if(resposta.status === 401){
                    alert("E-mail ou senha incorretos, tente novamente!");
                }

            }catch (erro) {
                console.error('Erro ao realizar o login:', erro);
                alert("Erro ao conectar com o servidor."+erro);
            
            }


        }

       
    </script>
}